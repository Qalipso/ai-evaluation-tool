# Copy to .env.local and fill. Never commit .env.local.

# OpenAI — powers the LLM-judge scoring engine
OPENAI_API_KEY=sk-...

# Supabase — persistence layer (service role, server-only)
# Project dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Demo gate (auth) — OPTIONAL. When DEMO_ACCESS_CODE is set, viewing stays
# public but evaluations/edits require the code at /enter. Leave unset locally.
# DEMO_ACCESS_CODE=letmein
# DEMO_SESSION_SECRET=<random 32+ char string>

# Optional overrides
# OPENAI_JUDGE_MODEL=gpt-4o-mini
# MAX_DAILY_LLM_USD=2
